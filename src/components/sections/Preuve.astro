---
import Cadre from './Cadre.astro';
import { lien } from '../../lib/contenu';
const { s, premier = false } = Astro.props as { s: any; premier?: boolean };
const attestations = (s.attestations || []).filter((a: any) => a.image);
---
<Cadre premier={premier} s={s} defaut="blanc" id={s.ancre || 'preuve'}>
  <div class="preuve">
    <div class="grille" style="margin-top:32px">
      {s.portrait && (
        <figure class="rv" style="margin:0">
          <div class="portrait"><img src={lien(s.portrait)} alt={s.nom || ''} loading="lazy" oncontextmenu="return false"></div>
          {(s.nom || s.fonction) && <figcaption class="legende"><b>{s.nom}</b>{s.fonction}</figcaption>}
        </figure>
      )}
      <div class="rv">
        {attestations.length > 0 && (
          <div class="attestations">
            {attestations.map((a: any) => (
              <button type="button" data-visionneuse={lien(a.image)} aria-label={`Agrandir l'attestation ${a.titre || ''}`}>
                <img src={lien(a.image)} alt="" loading="lazy" oncontextmenu="return false">
                <span><b>{a.titre}</b>{a.detail && <><br>{a.detail}</>}</span>
              </button>
            ))}
          </div>
        )}
        {s.mention && <p class="mention" style="margin-top:16px">{s.mention}</p>}
      </div>
    </div>
  </div>
</Cadre>
