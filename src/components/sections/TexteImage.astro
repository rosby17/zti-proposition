---
import Bouton from '../Bouton.astro';
import { md, lien } from '../../lib/contenu';
const { s, premier = false } = Astro.props as { s: any; premier?: boolean };
const Titre = premier ? 'h1' : 'h2';
const fond = s.fond || 'blanc';
const sombre = ['nuit', 'bleu', 'noir'].includes(fond);
---
<section class={`section texte-image fond-${fond} ${sombre ? 'sombre' : ''} ${s.image_position === 'gauche' ? 'image-gauche' : ''}`} id={s.ancre || undefined}>
  <div class="contenu">
    <div class={s.image ? 'grille' : 'etroit'}>
      <div class="rv">
        {s.etiquette && <span class="etiquette">{s.etiquette}</span>}
        {s.titre && <Titre>{s.titre}</Titre>}
        {s.texte && <div class="texte-riche" set:html={md(s.texte)} />}
        {s.points?.length > 0 && <ul class="liste-coches">{s.points.map((p: string) => <li>{p}</li>)}</ul>}
        {s.mention && <p class="mention" style="margin-top:18px">{s.mention}</p>}
        {s.bouton?.texte && <div class="actions"><Bouton texte={s.bouton.texte} href={s.bouton.lien || '#demande'} /></div>}
      </div>
      {s.image && <div class="visuel rv"><img src={lien(s.image)} alt={s.image_texte || ''} loading="lazy"></div>}
    </div>
  </div>
</section>
