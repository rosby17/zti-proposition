---
// Formulaire de demande : chaque demande part dans le CRM Notion de ZTi (copie dans le Google Sheet, et e-mail),
// avec la page, la campagne et la source de la publicité. Aucun contrôle natif : choix en boutons, case maison.
// Deux étapes (votre situation, puis vos coordonnées), ou une seule si la section est réglée « court ».
import Cadre from './Cadre.astro';
import Icone from '../Icone.astro';
import { reglages, services, lien } from '../../lib/contenu';
const { s, premier = false, page, campagne } = Astro.props as { s: any; premier?: boolean; page: string; campagne: string };
const r = await reglages();
const profils = [
  ['ecole', 'Établissement scolaire'], ['entreprise', 'Entreprise'], ['institution', 'Institution'], ['particulier', 'Particulier'],
];
const besoins: string[] = s.besoins?.length ? s.besoins : (await services()).map(x => x.data.titre);
const moments = ['Matin', 'Midi', 'Après-midi', 'Soir'];
// questions de qualification (reprises du formulaire Tally de ZTi) : étape 1 ; les coordonnées : étape 2
const court = !!s.court;
const postes = ['1 à 5', '6 à 20', '21 à 50', 'Plus de 50'];
const situations = [
  'Mes ordinateurs tombent souvent en panne ou sont très lents',
  "J'ai déjà perdu des données importantes",
  "J'ai peur de perdre mes données si une panne arrive",
  "Je n'ai pas de suivi informatique régulier",
  'Mes logiciels ne sont pas en règle (licences)',
  'Tout va bien, mais je veux anticiper les pannes',
];
const accompagnements = [
  "Un problème urgent : j'ai besoin d'une intervention rapide",
  'Sécuriser mon informatique sur le long terme',
  "Je ne sais pas encore : j'attends les conseils du diagnostic",
];
const prestataires = ['Oui, et je suis satisfait', 'Oui, mais je ne suis pas satisfait', "J'en avais un, plus maintenant", 'Non, personne'];
const depenses = ['Moins de 25 000 F / mois', '25 000 à 75 000 F / mois', '75 000 à 200 000 F / mois', 'Plus de 200 000 F / mois', 'Je ne sais pas'];
const secteurs = ['Commerce', 'BTP', 'Santé', 'Éducation', 'Finance', 'ONG', 'Industrie', 'Services', 'Autre'];
const connus = ['Facebook', 'LinkedIn', 'WhatsApp', 'Un ami ou un collègue', 'Un partenaire', 'Google', 'Autre'];
const id = s.ancre || 'demande';
---
<Cadre premier={premier} s={s} defaut="bleu" id={id}>
  <div class="demande">
    <div class="grille" style="margin-top:8px">
      <div class="rv">
        {s.garanties?.length > 0 && <ul class="liste-coches">{s.garanties.map((g: string) => <li>{g}</li>)}</ul>}
        {s.mention && <p class="mention" style="margin-top:18px">{s.mention}</p>}
      </div>
      <form class="formulaire rv" novalidate data-demande
        data-endpoint={(r.mesures?.endpoint || '').trim()} data-wa={r.contact.whatsapp} data-mail={r.contact.email}
        data-merci={lien('/merci/')} data-page={page} data-campagne={campagne} data-sujet={s.sujet || 'Demande'}>
        {!court && <p class="progression" aria-live="polite" data-progression>Étape 1 sur 2 · Votre situation</p>}

        <div class="etape" data-etape="1">
          <div class="champ" data-champ="profil">
            <span class="titre-champ" id={`${id}-profil`}>Vous êtes</span>
            <div class="choix" role="radiogroup" aria-labelledby={`${id}-profil`} data-choix="profil" data-unique>
              {profils.map(([v, t]) => <button type="button" role="radio" aria-checked={s.profil === v ? 'true' : 'false'} data-valeur={v}>{t}</button>)}
            </div>
            <span class="erreur">Choisissez une réponse.</span>
          </div>
          {!court && <>
            <div class="champ" data-champ="postes" data-requis>
              <span class="titre-champ" id={`${id}-postes`}>Nombre d'ordinateurs</span>
              <div class="choix" role="radiogroup" aria-labelledby={`${id}-postes`} data-choix="postes" data-unique>
                {postes.map(t => <button type="button" role="radio" aria-checked="false" data-valeur={t}>{t}</button>)}
              </div>
              <span class="erreur">Choisissez une réponse.</span>
            </div>
            <div class="champ" data-champ="situation" data-requis>
              <span class="titre-champ" id={`${id}-situation`}>Ce qui décrit le mieux votre informatique aujourd'hui</span>
              <div class="choix choix-liste" role="radiogroup" aria-labelledby={`${id}-situation`} data-choix="situation" data-unique>
                {situations.map(t => <button type="button" role="radio" aria-checked="false" data-valeur={t}>{t}</button>)}
              </div>
              <span class="erreur">Choisissez une réponse.</span>
            </div>
          </>}
          {besoins.length > 0 && (
            <div class="champ" data-champ="besoins">
              <span class="titre-champ" id={`${id}-besoins`}>Votre besoin <span class="facultatif">(plusieurs choix possibles)</span></span>
              <div class="choix" role="group" aria-labelledby={`${id}-besoins`} data-choix="besoins">
                {besoins.map(b => <button type="button" aria-pressed="false" data-valeur={b}>{b}</button>)}
              </div>
            </div>
          )}
          {!court && <>
            <div class="champ" data-champ="accompagnement" data-requis>
              <span class="titre-champ" id={`${id}-accompagnement`}>L'accompagnement qui vous correspond</span>
              <div class="choix choix-liste" role="radiogroup" aria-labelledby={`${id}-accompagnement`} data-choix="accompagnement" data-unique>
                {accompagnements.map(t => <button type="button" role="radio" aria-checked="false" data-valeur={t}>{t}</button>)}
              </div>
              <span class="erreur">Choisissez une réponse.</span>
            </div>
            <div class="champ" data-champ="prestataire">
              <span class="titre-champ" id={`${id}-prestataire`}>Avez-vous déjà un prestataire informatique ? <span class="facultatif">(facultatif)</span></span>
              <div class="choix" role="radiogroup" aria-labelledby={`${id}-prestataire`} data-choix="prestataire" data-unique>
                {prestataires.map(t => <button type="button" role="radio" aria-checked="false" data-valeur={t}>{t}</button>)}
              </div>
            </div>
            <div class="champ" data-champ="depenses">
              <span class="titre-champ" id={`${id}-depenses`}>Ce que vous dépensez aujourd'hui pour vos problèmes informatiques <span class="facultatif">(réparations et temps perdu compris, facultatif)</span></span>
              <div class="choix" role="radiogroup" aria-labelledby={`${id}-depenses`} data-choix="depenses" data-unique>
                {depenses.map(t => <button type="button" role="radio" aria-checked="false" data-valeur={t}>{t}</button>)}
              </div>
            </div>
          </>}
          <div class="champ" data-champ="message">
            <label for={`${id}-message`}>{court ? 'Votre message' : "Qu'est-ce qui vous pousse à faire cette demande aujourd'hui ?"} <span class="facultatif">(facultatif{court ? '' : ', une ou deux phrases suffisent'})</span></label>
            <textarea id={`${id}-message`} name="message" maxlength="1500"></textarea>
          </div>
          {!court && <p class="message-erreur" role="alert" hidden></p>}
          {!court && <div><button class="btn" type="button" data-suivant>Continuer<span class="pastille"><Icone nom="fleche" /></span></button></div>}
        </div>

        <div class="etape" data-etape="2" hidden={!court}>
          {!court && <button type="button" class="retour" data-retour>← Modifier ma situation</button>}
          <div class="champ" data-champ="organisation">
            <label for={`${id}-organisation`}>Nom de l'établissement ou de l'entreprise</label>
            <input id={`${id}-organisation`} name="organisation" autocomplete="organization" maxlength="120">
            <span class="erreur">Indiquez le nom de votre établissement ou de votre entreprise.</span>
          </div>
          {!court && (
            <div class="champ" data-champ="secteur">
              <span class="titre-champ" id={`${id}-secteur`}>Secteur d'activité <span class="facultatif">(facultatif)</span></span>
              <div class="choix" role="radiogroup" aria-labelledby={`${id}-secteur`} data-choix="secteur" data-unique>
                {secteurs.map(t => <button type="button" role="radio" aria-checked="false" data-valeur={t}>{t}</button>)}
              </div>
            </div>
          )}
          <div class="deux">
            <div class="champ" data-champ="nom">
              <label for={`${id}-nom`}>Nom et prénom</label>
              <input id={`${id}-nom`} name="nom" autocomplete="name" maxlength="80" required>
              <span class="erreur">Indiquez votre nom.</span>
            </div>
            <div class="champ" data-champ="fonction">
              <label for={`${id}-fonction`}>Fonction <span class="facultatif">(facultatif)</span></label>
              <input id={`${id}-fonction`} name="fonction" autocomplete="organization-title" maxlength="80" placeholder="Directeur, DG, gérant…">
            </div>
          </div>
          <div class="deux">
            <div class="champ" data-champ="tel">
              <label for={`${id}-tel`}>Téléphone / WhatsApp</label>
              <div class="telephone"><span>+237</span><input id={`${id}-tel`} name="tel" inputmode="tel" autocomplete="tel-national" maxlength="12" placeholder="6XX XX XX XX" required></div>
              <span class="erreur">9 chiffres, en commençant par 6.</span>
            </div>
            <div class="champ" data-champ="email">
              <label for={`${id}-email`}>E-mail <span class="facultatif">(facultatif)</span></label>
              <input id={`${id}-email`} name="email" type="email" autocomplete="email" maxlength="120">
              <span class="erreur">Cette adresse e-mail n'est pas valide.</span>
            </div>
          </div>
          <div class="champ" data-champ="lieu">
            <label for={`${id}-lieu`}>Quartier et ville <span class="facultatif">(facultatif)</span></label>
            <input id={`${id}-lieu`} name="lieu" autocomplete="address-level2" maxlength="120" placeholder="Par exemple : Messassi, Yaoundé">
          </div>
          <div class="champ" data-champ="moment">
            <span class="titre-champ" id={`${id}-moment`}>Meilleur moment pour vous rappeler <span class="facultatif">(facultatif)</span></span>
            <div class="choix" role="radiogroup" aria-labelledby={`${id}-moment`} data-choix="moment" data-unique>
              {moments.map(m => <button type="button" role="radio" aria-checked="false" data-valeur={m}>{m}</button>)}
            </div>
          </div>
          {!court && (
            <div class="champ" data-champ="connu">
              <span class="titre-champ" id={`${id}-connu`}>Comment avez-vous connu ZTi ? <span class="facultatif">(facultatif)</span></span>
              <div class="choix" role="radiogroup" aria-labelledby={`${id}-connu`} data-choix="connu" data-unique>
                {connus.map(t => <button type="button" role="radio" aria-checked="false" data-valeur={t}>{t}</button>)}
              </div>
            </div>
          )}
          <div class="piege" aria-hidden="true"><label>Ne pas remplir<input name="site_web" tabindex="-1" autocomplete="off"></label></div>
          <div class="champ" data-champ="accord">
            <button type="button" class="case" role="checkbox" aria-checked="false" data-case="accord">
              <span class="boite"><Icone nom="coche" /></span>
              <span>J'accepte que ZTi utilise ces informations uniquement pour me recontacter au sujet de ma demande. Elles ne sont ni communiquées ni cédées à des tiers (loi n° 2024/017).</span>
            </button>
            <span class="erreur">Votre accord est nécessaire pour que ZTi puisse vous recontacter.</span>
          </div>
          {s.garanties_bouton?.length > 0 && <div class="garanties">{s.garanties_bouton.map((g: string) => <span>{g}</span>)}</div>}
          <p class="message-erreur" role="alert" hidden></p>
          <div><button class="btn" type="submit">{s.bouton || 'Envoyer ma demande'}<span class="pastille"><Icone nom="fleche" /></span></button></div>
        </div>
      </form>
    </div>
  </div>
</Cadre>
